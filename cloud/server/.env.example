# Cascade Cloud server — copy to .env and fill in for local development.

PORT=8787
SESSION_SECRET=change-me-to-a-long-random-string
DATA_DIR=./data
WEB_ORIGIN=http://localhost:5173
OAUTH_REDIRECT_BASE_URL=http://localhost:8787

# GitHub OAuth App (github.com/settings/developers)
# Callback URL: <OAUTH_REDIRECT_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth Client (console.cloud.google.com/apis/credentials)
# Callback URL: <OAUTH_REDIRECT_BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to 1 to enable POST /auth/dev-login, a local-only login shortcut that
# skips real OAuth. Never set this in a real deployment.
CLOUD_DEV_BYPASS=0

# Provider keys for the OpenAI-compatible API (POST /v1/chat/completions) only —
# the web UI stays bring-your-own-key. Used ONLY while this instance has at most
# one account; a second account turns them off, so your key never silently pays
# for someone else's runs. See ../../.env.example for the full list and
# docs/openai-compat.md for the reasoning.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OLLAMA_BASE_URL=

# Read-only GitHub token for the landing page's download buttons, which resolve
# from the latest release. No scopes needed — it reads a public release. Unset
# means the call is unauthenticated, i.e. 60 requests/hour shared with every
# other tenant on the same egress IP; with a token it is 5,000/hour and yours.
GITHUB_API_TOKEN=

# Razorpay recurring subscriptions (dashboard.razorpay.com). All optional —
# billing is disabled and the Upgrade page shows "not configured" until
# KEY_ID + KEY_SECRET + PLAN_ID are set. Use rzp_test_* keys + a test Plan for
# development; swap to live keys only in the production deployment. KEY_SECRET
# and WEBHOOK_SECRET are server-only and must never be exposed to the client.
#   - PLAN_ID: create a recurring Plan in the Razorpay dashboard, then paste its id.
#   - WEBHOOK_SECRET: set on the Razorpay webhook (Settings → Webhooks) pointed at
#     <OAUTH_REDIRECT_BASE_URL>/api/billing/webhook, subscribing to subscription.* events.
#   - PRICE_LABEL: display-only text on the Upgrade page (the real price lives on the Plan).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_PRICE_LABEL=₹499 / month

# ══════════════════ OPTIONAL — remote browser for hosted runs ══════════════════
# Where a hosted run gets a browser from, so the agent can open a page and the
# user can watch it in the chat and stop it. Unset — the default — means hosted
# runs have no browser at all and the tool is never registered; there is no
# separate "off" switch because the capability does not exist until you supply
# an endpoint.
#
# This is OPERATOR config, not a per-user setting, and there is deliberately no
# field for it on the run payload: the value is a URL the SERVER opens a
# connection to, so accepting it from a request body would let any signed-in
# user aim that connection at your private network.
#
# The remote browser is NOT signed into anything. It is for public-web work;
# anything authenticated belongs on the desktop app, which drives a real
# Chromium you are already logged into.
#
#   PROVIDER=cdp    a browser you run — Browserless, a self-hosted Chrome,
#                   anything speaking CDP. URL must be ws:// or wss://.
#   PROVIDER=steel  a Steel deployment. URL is the API base (defaults to
#                   Steel's hosted API); API_KEY is its key.
REMOTE_BROWSER_PROVIDER=
REMOTE_BROWSER_URL=
REMOTE_BROWSER_API_KEY=
# Concurrent sessions across the whole deployment. Default 1, and deliberately
# so: every session is billed, and a wave of workers each opening their own is a
# cost you did not choose. A bare CDP endpoint is capped at 1 whatever this says
# — that endpoint IS one browser, so a second "session" would be the same page.
REMOTE_BROWSER_MAX_SESSIONS=1
