# ─────────────────────────────────────────────
#  Cascade Cloud server — environment config
#
#  Every variable here comes straight from cloud/server/src/env.ts, which is
#  the source of truth. Copy this file to `.env`, fill in the REQUIRED
#  section, and `docker compose up`.
#
#    cp .env.example .env
# ─────────────────────────────────────────────


# ══════════════════ REQUIRED ══════════════════

# Signs session cookies (JWT) and native/CLI access tokens. Must be at least
# 16 characters. The server refuses to start without it (env.ts validates
# this at boot and throws). Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# The zero-setup way to sign in to your self-hosted instance: adds a "Dev
# sign-in" button that creates a session for ANY name typed into it, with no
# GitHub/Google OAuth app required. It is what makes a fresh `docker compose
# up` usable with no cloud account at all.
#
# ⚠ THIS IS AN AUTHENTICATION BYPASS. Anyone who can reach the port can sign
# in as anyone — there is no password and no credential check. It is shipped
# COMMENTED OUT on purpose: copying this file must never, by itself, produce
# an instance that lets strangers in. Uncomment it only for an instance bound
# to localhost, which is how docker-compose.yml ships (127.0.0.1).
#
# For anything reachable by anyone else, leave this off and configure real
# OAuth (GITHUB_CLIENT_ID / GOOGLE_CLIENT_ID below) instead.
# CLOUD_DEV_BYPASS=1


# ══════════════════ OPTIONAL — server basics ══════════════════

# Port the server listens on (also the port cloud/web is served from — this
# is a single-port app, no separate web container). Default: 8787.
PORT=8787

# Where the SQLite database and per-tenant uploads live. Losing this
# directory loses all users, conversations, memories, and saved files, so
# docker-compose.yml mounts a named volume at this exact path — leave it as
# /data unless you also update the volume mount to match.
# Code default (outside Docker): ./data
DATA_DIR=/data

# The origin the browser is allowed to call this API/socket from (CORS), and
# where the browser is sent back to after a GitHub/Google OAuth login or an
# MCP connector's OAuth flow completes. In this single-container self-host
# setup the web UI is served from the same origin as the API, so this should
# match the URL you actually load in your browser (host + PORT above).
# Code default: http://localhost:5173 (the separate-process dev setup, not
# this one — override it for self-host as shown below).
WEB_ORIGIN=http://localhost:8787

# The server's own public base URL. Used to build OAuth redirect URIs
# (GitHub/Google login, MCP connector OAuth callbacks) and the CLI/desktop
# device-activation link (GET /activate). If you put this behind a reverse
# proxy or expose it beyond localhost, set this to that real public URL —
# GitHub/Google OAuth apps and MCP connector callbacks must match it exactly.
# Code default: http://localhost:8787
OAUTH_REDIRECT_BASE_URL=http://localhost:8787

# Hard per-run cost ceiling (USD), enforced by Cascade's own budget guard as
# a safety rail on top of per-plan entitlements. Default: 0.5
MAX_COST_PER_RUN_USD=0.5


# ══════════════════ OPTIONAL — provider keys for the OpenAI-compatible API ══════════════════
# Only POST /v1/chat/completions reads these. The web UI is unaffected: it stays
# bring-your-own-key, with keys held in the browser and sent with each run.
#
# ⚠ THESE ARE USED ONLY WHILE THIS INSTANCE HAS AT MOST ONE ACCOUNT — a
# self-host, where the operator and the caller are the same person. The moment a
# second account is created the server stops using them, because your key would
# otherwise pay for everyone else's runs with no per-user accounting. The server
# logs which of the two applies at boot ("[openai-compat] ..."). Callers on a
# multi-account instance pass their own keys per request instead, via the OpenAI
# SDK's extra_body={"providers": [...]}.
#
# Set as many or as few as you like — Cascade routes across whatever it has. The
# names are the same ones the Cascade CLI reads, so one .env can serve both.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=            # GOOGLE_API_KEY also accepted; GEMINI_API_KEY wins

# Azure needs all three before it is offered — a key with no endpoint or no
# deployment names no model, and would fail at run time instead of being
# visibly absent.
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=

# Any OpenAI-compatible endpoint (Groq, Together, vLLM, LM Studio, llama.cpp…).
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:1234/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=

# Local Ollama. From inside the container, localhost is the CONTAINER — point
# this at host.docker.internal (or the host's LAN address) to reach a daemon
# running on your machine.
# OLLAMA_BASE_URL=http://host.docker.internal:11434


# ══════════════════ OPTIONAL — "Sign in with GitHub / Google" ══════════════════
# Unset (default): the corresponding sign-in button is simply hidden — use
# CLOUD_DEV_BYPASS above instead, or fill both halves of one provider below
# to enable real OAuth login.

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=


# ══════════════════ OPTIONAL — one-click MCP connector auth ══════════════════
# Your OWN registered GitHub OAuth App (separate from the login one above),
# used only to make connecting the GitHub MCP connector one click instead of
# pasting a personal access token. Unset (default): connecting GitHub falls
# back to token-paste — nothing else is affected.

# CONNECT_GITHUB_CLIENT_ID=
# CONNECT_GITHUB_CLIENT_SECRET=


# ══════════════════ OPTIONAL — desktop download listing ══════════════════
# A GitHub token for the one API call that resolves the latest release into the
# download buttons on the landing page. It needs NO scopes — it reads a public
# release — and a fine-grained token with "Public repositories (read-only)" is
# enough.
#
# Unset (default): the call is unauthenticated, which GitHub limits to 60
# requests per hour PER IP. On a shared host that IP is shared with every other
# tenant on the same egress, so the real allowance is an unknown fraction of 60
# and the download section can fall back to a plain releases link for reasons
# that have nothing to do with this service. With a token the limit is
# 5,000/hour and it is yours alone.
#
# The last good result is also cached under DATA_DIR, so a restart does not
# start cold.

# GITHUB_API_TOKEN=


# ══════════════════ OPTIONAL — Razorpay billing ══════════════════
# All unset (default): billing is simply disabled and the Upgrade page shows
# "not configured" — everything else in the app works normally.

# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_ID=

# Display-only price string shown on the Upgrade page (the real price lives
# on the Razorpay Plan itself). Default: ₹499 / month
# RAZORPAY_PRICE_LABEL=₹499 / month


# ══════════════════ OPTIONAL — remote browser for hosted runs ══════════════════
# Where a hosted run gets a browser from, so the agent can open a page and the
# user can watch it in the chat and stop it. All unset (the default): hosted runs
# have no browser and the tool is never registered. There is no separate "off"
# switch because the capability does not exist until you supply an endpoint.
#
# OPERATOR config, and only that. There is deliberately no field for it on the
# run payload: the value is a URL the SERVER opens a connection to, so taking it
# from a request body would let any signed-in user aim that connection at your
# private network.
#
# The remote browser is NOT signed into anything — this surface is for public-web
# work. Anything authenticated belongs on the desktop app, which drives a real
# Chromium you are already logged into.
#
#   cdp    a browser you run (Browserless, a self-hosted Chrome, anything that
#          speaks CDP). REMOTE_BROWSER_URL must be ws:// or wss://.
#   steel  a Steel deployment. REMOTE_BROWSER_URL is the API base and defaults
#          to Steel's hosted API; REMOTE_BROWSER_API_KEY is its key.

# REMOTE_BROWSER_PROVIDER=cdp
# REMOTE_BROWSER_URL=ws://browserless:3000
# REMOTE_BROWSER_API_KEY=

# Concurrent sessions across the whole deployment. Default: 1, and deliberately
# so — every session is billed, and a wave of workers each opening their own is
# a cost you did not choose. A bare CDP endpoint is capped at 1 whatever this
# says: that endpoint IS one browser, so a second "session" would be the same
# page, and two runs would type into each other's forms.
# REMOTE_BROWSER_MAX_SESSIONS=1
