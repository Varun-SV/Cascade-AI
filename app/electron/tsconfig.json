{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "../dist-electron",
    "rootDir": "."
  },
  "include": ["."],
  // Tests are excluded because this config BUILDS the shipped Electron main
  // process: `rootDir` is `app/electron`, so anything compiled here must live
  // under it. A test importing the SDK (`../../src/index.js`) therefore fails
  // the whole desktop build with a wall of TS6059 "not under rootDir" errors —
  // which is what happened, and it broke CI while `tsc -p app/tsconfig.json`,
  // a different config with a different root, stayed clean locally.
  //
  // They are typechecked by `tsconfig.test.json` beside this file, which `npm
  // run lint` runs — NOT by the root `tsc --noEmit`, which includes only
  // `src/**/*` and excludes `**/*.test.ts`. An earlier version of this comment
  // claimed the root check covered them; it did not, and excluding them here
  // had quietly left them typechecked by nothing.
  "exclude": ["node_modules", "**/*.test.ts"]
}
